diff --git a/dts/upstream/src/arm64/rockchip/rk3399-odroid-n1.dts b/dts/upstream/src/arm64/rockchip/rk3399-odroid-n1.dts
new file mode 100755
index 00000000000..0468a3ffa26
--- /dev/null
+++ b/dts/upstream/src/arm64/rockchip/rk3399-odroid-n1.dts
@@ -0,0 +1,936 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
